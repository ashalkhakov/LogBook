# What Logbook builds on beside ORMKit, by the exact versions of their
# releases (gnustep-release-actions' scripts/deps.sh fetches them):
#   Apple  its XCFrameworks, unpacked into .deps/
#   Linux  its archive, unpacked into /opt/gnustep (.tools/gnustep.Dockerfile)
# The GNUstep stack, FreeCoreData and ODataKit come with ORMKit
# (../NativeORM2/.github/pins.env), whose runtime Logbook is built on.

# Reports: the generator and the viewer (RDLKit, RDLKitUI).
RDLKIT_VERSION=0.2.1

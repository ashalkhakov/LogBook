# What Logbook builds on, by the exact versions of their releases: the
# workflows (gnustep-release-actions' scripts/deps.sh) and
# .tools/gnustep.Dockerfile fetch them from here. To move one, edit it here.
#   Linux  each one's archive, unpacked into /opt/gnustep, the stack first
#   Apple  each one's XCFrameworks (and tools, bin/), unpacked into .deps/
#          (FreeCoreData has none: Apple's Core Data is the system's)

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.20.34
# Core Data on GNUstep, with momc (ashalkhakov/FreeCoreData); and the
# server's PostgreSQL and MySQL stores (StoreType), archives of their own.
FREECOREDATA_VERSION=0.11.0
FREECOREDATA_PARTS="postgresql mysql"
# HTTPServerKit's listener, which ODataKit's libraries link on GNUstep
# (ashalkhakov/GCDWebServer).
GCDWEBSERVER_VERSION=3.5.4.2
# The server's OData service and the offline store's sync (ODataSync)
# (ashalkhakov/ODataKit).
ODATAKIT_VERSION=0.4.3
# The model's runtime (ORMRuntime, for macOS, iOS and GNUstep) and ormtool,
# which generates from Model/Logbook.orm (ashalkhakov/ORMKit).
ORMKIT_VERSION=0.3.3
# Reports: the generator and the viewer (RDLKit, RDLKitUI).
RDLKIT_VERSION=0.3.0
# The Mac app's updates (AppKit/LBUpdater-Apple.m): Sparkle's XCFramework,
# embedded in Logbook.app (sparkle-project/Sparkle).
SPARKLE_VERSION=2.10.0

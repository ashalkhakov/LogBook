                        <rect key="frame" x="18" y="472" width="112" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Date:" id="row1LabelCell">
                            <font key="font" metaFont="system"/>

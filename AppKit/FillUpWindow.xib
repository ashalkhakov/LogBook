<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="LBFillUpWindowController">
            <connections>
                <outlet property="window" destination="fillUpWindow" id="fillUpWindowOutlet"/>
                <outlet property="messageLabel" destination="messageLabel" id="messageLabelOutlet"/>
                <outlet property="saveButton" destination="save" id="saveButtonOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <arrayController mode="entity" entityName="DistanceUnit" automaticallyPreparesContent="YES" userLabel="DistanceUnit" id="distanceUnits">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="distanceUnitsContext"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byTitle" id="distanceUnitsOrder"/>
            </connections>
        </arrayController>
        <arrayController mode="entity" entityName="VolumeUnit" automaticallyPreparesContent="YES" userLabel="VolumeUnit" id="volumeUnits">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="volumeUnitsContext"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byTitle" id="volumeUnitsOrder"/>
            </connections>
        </arrayController>
        <customObject id="currencies" userLabel="Currencies" customClass="LBCurrencies"/>
        <customObject id="distanceUnitsSource" userLabel="DistanceUnitsSource" customClass="UDKeyPathUnits">
            <userDefinedRuntimeAttributes>
                <userDefinedRuntimeAttribute type="string" keyPath="codeKeyPath" value="lbTitle"/>
            </userDefinedRuntimeAttributes>
            <connections>
                <outlet property="controller" destination="distanceUnits" id="distanceUnitsSourceController"/>
            </connections>
        </customObject>
        <customObject id="volumeUnitsSource" userLabel="VolumeUnitsSource" customClass="UDKeyPathUnits">
            <userDefinedRuntimeAttributes>
                <userDefinedRuntimeAttribute type="string" keyPath="codeKeyPath" value="lbTitle"/>
            </userDefinedRuntimeAttributes>
            <connections>
                <outlet property="controller" destination="volumeUnits" id="volumeUnitsSourceController"/>
            </connections>
        </customObject>
        <window title="Record a Fill-Up" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="YES" releasedWhenClosed="NO" animationBehavior="default" identifier="fillUpWindow" id="fillUpWindow">
            <windowStyleMask key="styleMask" titled="YES" closable="YES"/>
            <rect key="contentRect" x="320" y="200" width="500" height="560"/>
            <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
            <view key="contentView" id="fillUpContent">
                <rect key="frame" x="0" y="0" width="500" height="560"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="row0Label">
                        <rect key="frame" x="18" y="518" width="112" height="17"/>

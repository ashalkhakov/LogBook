                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Vehicle:" id="row0LabelCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" identifier="vehicle" id="row0Control">

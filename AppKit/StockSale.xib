  <objects>
    <customObject id="-2" userLabel="File's Owner" customClass="LBStockOrderWindowController">
      <connections>
        <outlet property="inspectorView" destination="screenInspector" id="screenInspectorOutlet"/>
        <outlet property="inspectorPages" destination="screenInspectorPages" id="screenInspectorPagesOutlet"/>
        <outlet property="view" destination="content" id="windowOutlet"/>
        <outlet property="returnAskPanel" destination="returnAskPanel" id="returnAskPanelOutlet"/>
        <outlet property="returnDoPanel" destination="returnDoPanel" id="returnDoPanelOutlet"/>
        <outlet property="confirmPanel" destination="confirmPanel" id="confirmPanelOutlet"/>
        <outlet property="shipPanel" destination="shipPanel" id="shipPanelOutlet"/>
        <outlet property="lineList" destination="lineList" id="lineListOutlet"/>
        <outlet property="linesTable" destination="linesTable" id="linesTableOutlet"/>
      </connections>
    </customObject>
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
    <customObject id="-3" userLabel="Application" customClass="NSObject"/>
    <arrayController userLabel="row-documentsTable-movesList" id="row-documentsTable-movesList">

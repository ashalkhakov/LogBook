    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="LBListsController">
            <connections>
                <outlet property="window" destination="listsWindow" id="listsWindowOutlet"/>
                <outlet property="tabs" destination="tabs" id="tabsOutlet"/>
                <outlet property="expenseKinds" destination="expenseKinds" id="expenseKindsOutlet"/>
                <outlet property="checklists" destination="checklists" id="checklistsOutlet"/>
                <outlet property="questions" destination="questions" id="questionsOutlet"/>
                <outlet property="options" destination="options" id="optionsOutlet"/>
                <outlet property="expenseKindsTable" destination="expenseKindsTable" id="expenseKindsTableOutlet"/>
                <outlet property="checklistsTable" destination="checklistsTable" id="checklistsTableOutlet"/>
                <outlet property="questionsTable" destination="questionsTable" id="questionsTableOutlet"/>
                <outlet property="optionsTable" destination="optionsTable" id="optionsTableOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <arrayController mode="entity" entityName="ExpenseKind" automaticallyPreparesContent="YES" userLabel="Expense Kinds" id="expenseKinds">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="expenseKindsContext"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byTitle" id="expenseKindsOrder"/>
            </connections>
        </arrayController>
        <arrayController mode="entity" entityName="Checklist" automaticallyPreparesContent="YES" userLabel="Checklists" id="checklists">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="checklistsContext"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byTitle" id="checklistsOrder"/>
            </connections>
        </arrayController>
        <arrayController objectClassName="Question" editable="YES" userLabel="Questions" id="questions">
            <connections>
                <binding destination="checklists" name="contentSet" keyPath="selection.questions" id="questionsContent"/>
            </connections>
        </arrayController>
        <arrayController objectClassName="Option" editable="YES" userLabel="Options" id="options">
            <connections>
                <binding destination="questions" name="contentSet" keyPath="selection.options" id="optionsContent"/>
            </connections>
        </arrayController>

              <binding destination="countRows" name="enabled" keyPath="arrangedObjects.@count" id="postCountEnabled"/>
            </connections>
          </button>
        </subviews>
      </view>
      <connections>
        <outlet property="delegate" destination="-2" id="windowDelegate"/>
      </connections>
    </window>
  </objects>
</document>

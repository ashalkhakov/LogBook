<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="LBPreferencesController">
            <connections>
                <outlet property="window" destination="panel" id="panelOutlet"/>
                <outlet property="userController" destination="user" id="userControllerOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <objectController objectClassName="User" userLabel="User" id="user">
            <connections>
                <binding destination="-2" name="contentObject" keyPath="user" id="userContent"/>
            </connections>
        </objectController>
        <customObject id="currencies" userLabel="Currencies" customClass="LBCurrencies"/>
        <arrayController mode="entity" entityName="DistanceUnit" automaticallyPreparesContent="YES" userLabel="DistanceUnit" id="distanceUnits">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="distanceUnitsContext"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byTitle" id="distanceUnitsOrder"/>
            </connections>
        </arrayController>
        <arrayController mode="entity" entityName="VolumeUnit" automaticallyPreparesContent="YES" userLabel="VolumeUnit" id="volumeUnits">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="volumeUnitsContext"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byTitle" id="volumeUnitsOrder"/>
            </connections>
        </arrayController>
        <window title="Preferences" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="LogbookPreferences" animationBehavior="default" id="panel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES"/>
            <rect key="contentRect" x="300" y="400" width="440" height="250"/>
            <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
            <view key="contentView" id="panelContent">
                <rect key="frame" x="0" y="0" width="440" height="250"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="personNameLabel">
                        <rect key="frame" x="16" y="209" width="100" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Name:" id="personNameLabelCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField verticalHuggingPriority="750" identifier="personName" id="personName">
                        <rect key="frame" x="124" y="206" width="296" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" alignment="left" drawsBackground="YES" id="personNameCell">
                            
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                        <connections>
                            <binding destination="user" name="value" keyPath="selection.personName" id="personNameValue">
                                <dictionary key="options">
                                    <bool key="NSValidatesImmediately" value="YES"/>
                                </dictionary>
                            </binding>
                        </connections>
                    </textField>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="emailLabel">
                        <rect key="frame" x="16" y="177" width="100" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Email:" id="emailLabelCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField verticalHuggingPriority="750" identifier="email" id="email">
                        <rect key="frame" x="124" y="174" width="296" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="NO" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" alignment="left" drawsBackground="YES" id="emailCell">
                            
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                        <connections>
                            <binding destination="user" name="value" keyPath="selection.email" id="emailValue">
                                <dictionary key="options">
                                    <bool key="NSValidatesImmediately" value="YES"/>
                                </dictionary>
                            </binding>
                        </connections>
                    </textField>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="currencyLabel">
                        <rect key="frame" x="16" y="145" width="100" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Currency:" id="currencyLabelCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <customView identifier="currency" id="currency" customClass="UDQuantityField">
                        <rect key="frame" x="124" y="140" width="200" height="26"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <userDefinedRuntimeAttributes>
                            <userDefinedRuntimeAttribute type="boolean" keyPath="showsValue" value="NO"/>
                        </userDefinedRuntimeAttributes>
                        <connections>
                            <outlet property="units" destination="currencies" id="currencyUnits"/>
                            <binding destination="user" name="unit" keyPath="selection.currency" id="currencyValue">
                                <dictionary key="options">
                                    <bool key="NSValidatesImmediately" value="YES"/>
                                </dictionary>
                            </binding>
                        </connections>
                    </customView>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="distanceUnitLabel">
                        <rect key="frame" x="16" y="113" width="100" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Distance in:" id="distanceUnitLabelCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <popUpButton verticalHuggingPriority="750" identifier="distanceUnit" id="distanceUnit">
                        <rect key="frame" x="122" y="108" width="300" height="26"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="distanceUnitCell">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                            <menu key="menu" id="distanceUnitMenu"/>
                        </popUpButtonCell>
                        <connections>
                            <binding destination="distanceUnits" name="content" keyPath="arrangedObjects" id="distanceUnitContent"/>
                            <binding destination="distanceUnits" name="contentValues" keyPath="arrangedObjects.lbTitle" previousBinding="distanceUnitContent" id="distanceUnitValues">
                                <dictionary key="options">
                                    <bool key="NSInsertsNullPlaceholder" value="YES"/>
                                    <string key="NSNullPlaceholder">None</string>
                                </dictionary>
                            </binding>
                            <binding destination="user" name="selectedObject" keyPath="selection.distanceUnit" previousBinding="distanceUnitValues" id="distanceUnitChosen"/>
                        </connections>
                    </popUpButton>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="volumeUnitLabel">
                        <rect key="frame" x="16" y="81" width="100" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Volume in:" id="volumeUnitLabelCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <popUpButton verticalHuggingPriority="750" identifier="volumeUnit" id="volumeUnit">
                        <rect key="frame" x="122" y="76" width="300" height="26"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="volumeUnitCell">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                            <menu key="menu" id="volumeUnitMenu"/>
                        </popUpButtonCell>
                        <connections>
                            <binding destination="volumeUnits" name="content" keyPath="arrangedObjects" id="volumeUnitContent"/>
                            <binding destination="volumeUnits" name="contentValues" keyPath="arrangedObjects.lbTitle" previousBinding="volumeUnitContent" id="volumeUnitValues">
                                <dictionary key="options">
                                    <bool key="NSInsertsNullPlaceholder" value="YES"/>
                                    <string key="NSNullPlaceholder">None</string>
                                </dictionary>
                            </binding>
                            <binding destination="user" name="selectedObject" keyPath="selection.volumeUnit" previousBinding="volumeUnitValues" id="volumeUnitChosen"/>
                        </connections>
                    </popUpButton>
                    <button verticalHuggingPriority="750" identifier="done" id="done">
                        <rect key="frame" x="324" y="13" width="100" height="32"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                        <buttonCell key="cell" type="push" title="Done" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="doneCell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="done:" target="-2" id="doneAction"/>
                            
                        </connections>
                    </button>
                </subviews>
            </view>
            <connections>
                <outlet property="delegate" destination="-2" id="panelDelegate"/>
            </connections>
        </window>
    </objects>
</document>

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="LBMainWindowController">
            <connections>
                <outlet property="window" destination="window" id="windowOutlet"/>
                <outlet property="vehicles" destination="vehicles" id="vehiclesOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <arrayController objectClassName="Vehicle" customClass="LBVehicleController" userLabel="Vehicles" id="vehicles">
            <connections>
                <binding destination="-2" name="context" keyPath="context" id="vehiclesContext"/>
                <outlet property="windowController" destination="-2" id="vehiclesWindowController"/>
            </connections>
        </arrayController>
        <window title="Logbook" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="LogbookMainWindow" animationBehavior="default" id="window">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <rect key="contentRect" x="160" y="160" width="960" height="600"/>
            <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
            <view key="contentView" id="contentView">
                <rect key="frame" x="0" y="0" width="960" height="600"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <scrollView autohidesScrollers="YES" horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" usesPredominantAxisScrolling="NO" id="vehiclesTableScroll">
                        <rect key="frame" x="20" y="60" width="280" height="520"/>
                        <autoresizingMask key="autoresizingMask" heightSizable="YES" flexibleMaxX="YES"/>
                        <clipView key="contentView" id="vehiclesTableClip">
                            <rect key="frame" x="1" y="1" width="278" height="518"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" headerView="vehiclesTableHeader" identifier="vehiclesTable" id="vehiclesTable">
                                    <rect key="frame" x="0" y="0" width="278" height="495"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <size key="intercellSpacing" width="3" height="2"/>
                                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                    <tableColumns>
                    <tableColumn identifier="vehicleName" width="140" minWidth="40" maxWidth="1000" id="vehiclesTableVehicleNameColumn">
                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Vehicle">
                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                        </tableHeaderCell>
                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" alignment="left" title="Text Cell" id="vehiclesTableVehicleNameCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                        <connections>
                            <binding destination="vehicles" name="value" keyPath="arrangedObjects.vehicleName" id="vehiclesTableVehicleNameValue"/>
                        </connections>
                    </tableColumn>
                    <tableColumn identifier="make" width="120" minWidth="40" maxWidth="1000" id="vehiclesTableMakeColumn">
                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Make">
                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                        </tableHeaderCell>
                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" alignment="left" title="Text Cell" id="vehiclesTableMakeCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                        <connections>
                            <binding destination="vehicles" name="value" keyPath="arrangedObjects.make" id="vehiclesTableMakeValue"/>
                        </connections>
                    </tableColumn>
                                    </tableColumns>
                                </tableView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="vehiclesTableHScroller">
                            <rect key="frame" x="1" y="504" width="278" height="15"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        </scroller>
                        <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="NO" id="vehiclesTableVScroller">

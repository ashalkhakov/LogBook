                            <binding destination="vehicles" name="value" keyPath="arrangedObjects.make" id="vehiclesTableMakeValue"/>
                        </connections>
                    </tableColumn>
                                    </tableColumns>
                                </tableView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="vehiclesTableHScroller">
                            <rect key="frame" x="1" y="584" width="258" height="15"/>

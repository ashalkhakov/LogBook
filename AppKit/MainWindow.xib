                                <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" headerView="vehiclesTableHeader" identifier="vehiclesTable" id="vehiclesTable">

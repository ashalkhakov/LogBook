        <window title="Logbook" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="LogbookMainWindow" animationBehavior="default" id="window">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <rect key="contentRect" x="160" y="120" width="1060" height="680"/>
            <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
            <view key="contentView" id="contentView">
                <rect key="frame" x="0" y="0" width="1060" height="680"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <scrollView autohidesScrollers="YES" hasHorizontalScroller="NO" horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" usesPredominantAxisScrolling="NO" id="vehiclesTableScroll">
                        <rect key="frame" x="20" y="60" width="260" height="600"/>
                        <autoresizingMask key="autoresizingMask" heightSizable="YES" flexibleMaxX="YES"/>

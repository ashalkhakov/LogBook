<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" customObjectInstantitationMethod="direct">
  <dependencies>
    <deployment identifier="macosx"/>
    <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
  </dependencies>
  <objects>
    <customObject id="-2" userLabel="File's Owner" customClass="LBPartsPanelController">
      <connections>
        <outlet property="window" destination="window" id="windowOutlet"/>
        <outlet property="partList" destination="partList" id="partListOutlet"/>
      </connections>
    </customObject>
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
    <customObject id="-3" userLabel="Application" customClass="NSObject"/>
    <arrayController editable="YES" userLabel="Parts" id="partList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="parts" id="partListContent"/>
      </connections>
    </arrayController>
    <window title="Parts" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="LogbookParts" animationBehavior="default" id="window">
      <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
      <rect key="contentRect" x="180" y="140" width="560" height="360"/>
      <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
      <value key="minSize" type="size" width="560" height="360"/>
      <view key="contentView" id="content">
        <rect key="frame" x="0" y="0" width="560" height="360"/>
        <autoresizingMask key="autoresizingMask"/>
        <subviews>
          <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="partsFromLabel">
            <rect key="frame" x="14" y="325" width="50" height="17"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="From" id="partsFromLabelCell">
              <font key="font" metaFont="system"/>
              <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
          </textField>
          <popUpButton verticalHuggingPriority="750" identifier="partsFrom" id="partsFrom">
            <rect key="frame" x="70" y="319" width="320" height="26"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="partsFromCell">
              <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
              <menu key="menu" id="partsFromMenu"/>
            </popUpButtonCell>
            <connections>
              <binding destination="-2" name="content" keyPath="locations" id="partsFromContent"/>
              <binding destination="-2" name="contentValues" keyPath="locations.lbTitle" previousBinding="partsFromContent" id="partsFromValues"/>
              <binding destination="-2" name="selectedObject" keyPath="partsLocation" previousBinding="partsFromValues" id="partsFromChosen"/>
            </connections>
          </popUpButton>
          <scrollView autohidesScrollers="YES" hasHorizontalScroller="NO" horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" usesPredominantAxisScrolling="NO" id="partsTableScroll">
            <rect key="frame" x="14" y="110" width="532" height="196"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <clipView key="contentView" id="partsTableClip">
              <rect key="frame" x="1" y="1" width="530" height="194"/>
              <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
              <subviews>
                <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" headerView="partsTableHeader" identifier="partsTable" id="partsTable">
                  <rect key="frame" x="0" y="0" width="530" height="171"/>
                  <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                  <size key="intercellSpacing" width="3" height="2"/>
                  <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                  <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                  <tableColumns>
                    <tableColumn identifier="item" width="230" minWidth="30" maxWidth="1000" id="partsTableItemColumn">
                      <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Part">
                        <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                      </tableHeaderCell>
                      <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="partsTableItemCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                      </textFieldCell>
                      <connections>
                        <binding destination="partList" name="value" keyPath="arrangedObjects.stockItem.lbTitle" id="partsTableItemValue"/>
                      </connections>
                    </tableColumn>
                    <tableColumn identifier="quantity" width="80" minWidth="30" maxWidth="1000" id="partsTableQuantityColumn">
                      <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="How many">
                        <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                      </tableHeaderCell>
                      <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="partsTableQuantityCell">
                        <numberFormatter key="formatter" formatterBehavior="custom10_4" generatesDecimalNumbers="YES" usesGroupingSeparator="NO" groupingSize="0" minimumIntegerDigits="1" maximumIntegerDigits="42" maximumFractionDigits="3" id="partsTableQuantityFormatter"/>
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                      </textFieldCell>
                      <connections>
                        <binding destination="partList" name="value" keyPath="arrangedObjects.quantity" id="partsTableQuantityValue"/>
                      </connections>
                    </tableColumn>
                    <tableColumn identifier="price" width="80" minWidth="30" maxWidth="1000" id="partsTablePriceColumn">
                      <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Each">
                        <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                      </tableHeaderCell>
                      <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="partsTablePriceCell">
                        <numberFormatter key="formatter" formatterBehavior="custom10_4" generatesDecimalNumbers="YES" usesGroupingSeparator="NO" groupingSize="0" minimumIntegerDigits="1" maximumIntegerDigits="42" maximumFractionDigits="3" id="partsTablePriceFormatter"/>
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                      </textFieldCell>
                      <connections>
                        <binding destination="partList" name="value" keyPath="arrangedObjects.linePriceAmount" id="partsTablePriceValue"/>
                      </connections>
                    </tableColumn>
                    <tableColumn identifier="used" width="80" minWidth="30" maxWidth="1000" id="partsTableUsedColumn">
                      <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Used">
                        <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                      </tableHeaderCell>
                      <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="partsTableUsedCell">
                        <numberFormatter key="formatter" formatterBehavior="custom10_4" generatesDecimalNumbers="YES" usesGroupingSeparator="NO" groupingSize="0" minimumIntegerDigits="1" maximumIntegerDigits="42" maximumFractionDigits="3" id="partsTableUsedFormatter"/>
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                      </textFieldCell>
                      <connections>
                        <binding destination="partList" name="value" keyPath="arrangedObjects.shippedQuantity" id="partsTableUsedValue"/>
                      </connections>
                    </tableColumn>
                  </tableColumns>
                </tableView>
              </subviews>
            </clipView>
            <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="partsTableHScroller">
              <rect key="frame" x="1" y="180" width="530" height="15"/>
              <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
            </scroller>
            <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="NO" id="partsTableVScroller">
              <rect key="frame" x="516" y="1" width="15" height="194"/>
              <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
            </scroller>
            <tableHeaderView key="headerView" id="partsTableHeader">
              <rect key="frame" x="0" y="0" width="530" height="23"/>
              <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
            </tableHeaderView>
          </scrollView>
          <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="partItemLabel">
            <rect key="frame" x="14" y="79" width="40" height="17"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Item" id="partItemLabelCell">
              <font key="font" metaFont="system"/>
              <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
          </textField>
          <popUpButton verticalHuggingPriority="750" identifier="partItem" id="partItem">
            <rect key="frame" x="59" y="73" width="260" height="26"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="partItemCell">
              <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
              <menu key="menu" id="partItemMenu"/>
            </popUpButtonCell>
            <connections>
              <binding destination="-2" name="content" keyPath="items" id="partItemContent"/>
              <binding destination="-2" name="contentValues" keyPath="items.lbTitle" previousBinding="partItemContent" id="partItemValues"/>
              <binding destination="-2" name="selectedObject" keyPath="chosenItem" previousBinding="partItemValues" id="partItemChosen"/>
            </connections>
          </popUpButton>
          <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="partQuantityLabel">
            <rect key="frame" x="324" y="79" width="70" height="17"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="How many" id="partQuantityLabelCell">
              <font key="font" metaFont="system"/>
              <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
          </textField>
          <textField verticalHuggingPriority="750" identifier="partQuantity" id="partQuantity">
            <rect key="frame" x="399" y="76" width="60" height="22"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" drawsBackground="YES" id="partQuantityCell">
              <font key="font" metaFont="system"/>
              <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
            <connections>
              <binding destination="-2" name="value" keyPath="quantityText" id="partQuantityValue"/>
            </connections>
          </textField>
          <button verticalHuggingPriority="750" identifier="usePart" id="usePart">
            <rect key="frame" x="464" y="70" width="86" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <buttonCell key="cell" type="push" title="Use" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="usePartCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="usePart:" target="-2" id="usePartAction"/>
            </connections>
          </button>
          <button verticalHuggingPriority="750" identifier="removePart" id="removePart">
            <rect key="frame" x="10" y="10" width="100" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <buttonCell key="cell" type="push" title="Remove" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="removePartCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="removePart:" target="-2" id="removePartAction"/>
              <binding destination="partList" name="enabled" keyPath="canRemove" id="removePartEnabled"/>
            </connections>
          </button>
          <button verticalHuggingPriority="750" identifier="partsDone" id="partsDone">
            <rect key="frame" x="450" y="10" width="100" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
            <buttonCell key="cell" type="push" title="Done" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="partsDoneCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="done:" target="-2" id="partsDoneAction"/>
            </connections>
          </button>
        </subviews>
      </view>
      <connections>
        <outlet property="delegate" destination="-2" id="windowDelegate"/>
      </connections>
    </window>
  </objects>
</document>

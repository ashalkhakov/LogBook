    <window title="Confirm the order" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="confirmPanel" customClass="NSPanel">
      <windowStyleMask key="styleMask" titled="YES"/>
      <rect key="contentRect" x="200" y="200" width="420" height="340"/>
      <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
      <view key="contentView" id="confirmPanelContent">
        <rect key="frame" x="0" y="0" width="420" height="340"/>
        <autoresizingMask key="autoresizingMask"/>
        <subviews>
          <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="confirmSupplierLabel">
            <rect key="frame" x="14" y="303" width="90" height="17"/>

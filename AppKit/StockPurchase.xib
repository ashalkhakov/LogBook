        <outlet property="confirmPanel" destination="confirmPanel" id="confirmPanelOutlet"/>
        <outlet property="receivePanel" destination="receivePanel" id="receivePanelOutlet"/>
      </connections>
    </customObject>
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
    <customObject id="-3" userLabel="Application" customClass="NSObject"/>
    <objectController objectClassName="PurchaseOrder" userLabel="Order Form" id="EditPurchaseOrderForm">
      <connections>
        <binding destination="-2" name="contentObject" keyPath="orderForm" id="EditPurchaseOrderFormContent"/>
      </connections>

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" customObjectInstantitationMethod="direct">
  <dependencies>
    <deployment identifier="macosx"/>
    <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
  </dependencies>
  <objects>
    <customObject id="-2" userLabel="File's Owner" customClass="LBCatalogSettingsWindowController">
      <connections>
        <outlet property="view" destination="content" id="windowOutlet"/>
        <outlet property="warehouseList" destination="warehouseList" id="warehouseListOutlet"/>
        <outlet property="locationList" destination="locationList" id="locationListOutlet"/>
        <outlet property="categoryList" destination="categoryList" id="categoryListOutlet"/>
        <outlet property="contactList" destination="contactList" id="contactListOutlet"/>
        <outlet property="warehousesTable" destination="warehousesTable" id="warehousesTableOutlet"/>
        <outlet property="locationsTable" destination="locationsTable" id="locationsTableOutlet"/>
        <outlet property="categoriesTable" destination="categoriesTable" id="categoriesTableOutlet"/>
        <outlet property="contactsTable" destination="contactsTable" id="contactsTableOutlet"/>
        <outlet property="tabs" destination="tabs" id="tabsOutlet"/>
      </connections>
    </customObject>
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
    <customObject id="-3" userLabel="Application" customClass="NSObject"/>
    <arrayController editable="YES" userLabel="Warehouses" id="warehouseList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="warehouses" id="warehouseListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Locations" id="locationList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="warehouseLocations" id="locationListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Categories" id="categoryList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="categories" id="categoryListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Contacts" id="contactList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="contacts" id="contactListContent"/>
      </connections>
    </arrayController>
    <customView userLabel="Screen" id="content">
        <rect key="frame" x="0" y="0" width="960" height="600"/>
        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>

                    <button verticalHuggingPriority="750" identifier="save" id="save">
                        <rect key="frame" x="985" y="677" width="100" height="32"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>

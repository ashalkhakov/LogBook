<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="LBStockWindowController">
            <connections>
                <outlet property="window" destination="stockWindow" id="windowOutlet"/>
                <outlet property="catalogs" destination="catalogs" id="catalogsOutlet"/>
                <outlet property="items" destination="items" id="itemsOutlet"/>
                <outlet property="holdings" destination="holdings" id="holdingsOutlet"/>
                <outlet property="kitLines" destination="kitLines" id="kitLinesOutlet"/>
                <outlet property="moves" destination="moves" id="movesOutlet"/>
                <outlet property="tabs" destination="stockTabs" id="tabsOutlet"/>
                <outlet property="itemSearch" destination="itemSearch" id="itemSearchOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <arrayController mode="entity" entityName="Catalog" editable="YES" automaticallyPreparesContent="YES" userLabel="Catalogs" id="catalogs">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="catalogsContext"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byTitle" id="catalogsOrder"/>
            </connections>
        </arrayController>
        <arrayController mode="entity" entityName="StockItem" editable="YES" automaticallyPreparesContent="YES" customClass="LBStockItemController" userLabel="Items" id="items">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="itemsContext"/>
                <binding destination="catalogs" name="contentSet" keyPath="selection.stockItems" id="itemsContent"/>
                <binding destination="-2" name="sortDescriptors" keyPath="byName" id="itemsOrder"/>
                <outlet property="windowController" destination="-2" id="itemswindowControllerOutlet"/>
            </connections>
        </arrayController>
        <arrayController mode="entity" entityName="Holding" editable="YES" automaticallyPreparesContent="YES" userLabel="Holdings" id="holdings">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="holdingsContext"/>
                <binding destination="items" name="contentSet" keyPath="selection.holdings" id="holdingsContent"/>
            </connections>
        </arrayController>
        <arrayController mode="entity" entityName="KitLine" editable="YES" automaticallyPreparesContent="YES" customClass="LBKitLineController" userLabel="Recipe" id="kitLines">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="kitLinesContext"/>
                <binding destination="items" name="contentSet" keyPath="selection.kitLinesAsKit" id="kitLinesContent"/>
            </connections>
        </arrayController>
        <arrayController mode="entity" entityName="Move" editable="YES" automaticallyPreparesContent="YES" userLabel="Moves" id="moves">
            <connections>
                <binding destination="-2" name="managedObjectContext" keyPath="context" id="movesContext"/>
                <binding destination="items" name="contentSet" keyPath="selection.moves" id="movesContent"/>
                <binding destination="-2" name="sortDescriptors" keyPath="latestFirst" id="movesOrder"/>
            </connections>
        </arrayController>
        <window title="Stock" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="LogbookStock" animationBehavior="default" id="stockWindow">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <rect key="contentRect" x="160" y="160" width="1100" height="720"/>
            <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
            <value key="minSize" type="size" width="1100" height="720"/>
            <view key="contentView" id="stockContent">
                <rect key="frame" x="0" y="0" width="1100" height="720"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="catalogLabel">
                        <rect key="frame" x="14" y="686" width="60" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Catalog" id="catalogLabelCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <popUpButton verticalHuggingPriority="750" identifier="stockCatalog" id="stockCatalog">
                        <rect key="frame" x="78" y="680" width="220" height="26"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="stockCatalogCell">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                            <menu key="menu" id="stockCatalogMenu"/>
                        </popUpButtonCell>
                        <connections>
                            <binding destination="catalogs" name="content" keyPath="arrangedObjects" id="stockCatalogContent"/>
                            <binding destination="catalogs" name="contentValues" keyPath="arrangedObjects.lbTitle" previousBinding="stockCatalogContent" id="stockCatalogValues"/>
                            <binding destination="catalogs" name="selectedIndex" keyPath="selectionIndex" previousBinding="stockCatalogValues" id="stockCatalogChosen"/>
                        </connections>
                    </popUpButton>
                    <textField verticalHuggingPriority="750" identifier="catalogName" id="catalogName">
                        <rect key="frame" x="306" y="682" width="200" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" drawsBackground="YES" id="catalogNameCell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                        <connections>
                            <binding destination="catalogs" name="value" keyPath="selection.catalogName" id="catalogNameValue"/>
                        </connections>
                    </textField>
                    <button verticalHuggingPriority="750" identifier="newCatalog" id="newCatalog">
                        <rect key="frame" x="510" y="677" width="130" height="32"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="New Catalog" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="newCatalogCell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="newCatalog:" target="-2" id="newCatalogAction"/>
                        </connections>
                    </button>
                    <button verticalHuggingPriority="750" identifier="revert" id="revert">
                        <rect key="frame" x="890" y="677" width="95" height="32"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Revert" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="revertCell">

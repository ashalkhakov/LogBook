                      </connections>
                    </textField>
                    <button identifier="contactCompany" id="contactCompany">
                      <rect key="frame" x="605" y="100" width="200" height="18"/>
                      <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                      <buttonCell key="cell" type="check" title="A company" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="contactCompanyCell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                      </buttonCell>
                      <connections>
                        <binding destination="contacts" name="value" keyPath="selection.isACompany" id="contactCompanyValue"/>
                      </connections>
                    </button>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="contactNoteLabel">
                      <rect key="frame" x="540" y="69" width="60" height="17"/>

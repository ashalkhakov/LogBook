                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                      </textFieldCell>
                    </textField>
                    <textField verticalHuggingPriority="750" identifier="contactShipTo" id="contactShipTo">
                      <rect key="frame" x="605" y="128" width="439" height="22"/>
                      <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                      <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" drawsBackground="YES" id="contactShipToCell">
                        <font key="font" metaFont="system"/>

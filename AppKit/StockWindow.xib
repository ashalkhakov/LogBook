                  <rect key="frame" x="10" y="33" width="954" height="534"/>
                  <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                  <subviews>
                    <searchField wantsLayer="YES" verticalHuggingPriority="750" identifier="itemSearch" id="itemSearch">

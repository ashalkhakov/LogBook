    <window title="Stock" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="LogbookStock" animationBehavior="default" id="stockWindow">
      <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
      <rect key="contentRect" x="160" y="160" width="1100" height="720"/>
      <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
      <value key="minSize" type="size" width="1100" height="720"/>
      <view key="contentView" id="stockContent">
        <rect key="frame" x="0" y="0" width="1100" height="720"/>
        <autoresizingMask key="autoresizingMask"/>
        <subviews>
          <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="catalogLabel">
            <rect key="frame" x="14" y="686" width="60" height="17"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Catalog" id="catalogLabelCell">
              <font key="font" metaFont="system"/>
              <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
          </textField>
          <popUpButton verticalHuggingPriority="750" identifier="stockCatalog" id="stockCatalog">
            <rect key="frame" x="78" y="680" width="220" height="26"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="stockCatalogCell">
              <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
              <menu key="menu" id="stockCatalogMenu"/>
            </popUpButtonCell>
            <connections>
              <binding destination="catalogs" name="content" keyPath="arrangedObjects" id="stockCatalogContent"/>
              <binding destination="catalogs" name="contentValues" keyPath="arrangedObjects.lbTitle" previousBinding="stockCatalogContent" id="stockCatalogValues"/>
              <binding destination="catalogs" name="selectedIndex" keyPath="selectionIndex" previousBinding="stockCatalogValues" id="stockCatalogChosen"/>
            </connections>
          </popUpButton>
          <textField verticalHuggingPriority="750" identifier="catalogName" id="catalogName">
            <rect key="frame" x="306" y="682" width="200" height="22"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" drawsBackground="YES" id="catalogNameCell">
              <font key="font" metaFont="system"/>
              <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
            <connections>
              <binding destination="catalogs" name="value" keyPath="selection.catalogName" id="catalogNameValue"/>
            </connections>
          </textField>
          <button verticalHuggingPriority="750" identifier="newCatalog" id="newCatalog">
            <rect key="frame" x="510" y="677" width="130" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <buttonCell key="cell" type="push" title="New Catalog" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="newCatalogCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="newCatalog:" target="-2" id="newCatalogAction"/>
            </connections>
          </button>
          <button verticalHuggingPriority="750" identifier="revert" id="revert">
            <rect key="frame" x="890" y="677" width="95" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
            <buttonCell key="cell" type="push" title="Revert" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="revertCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="revertChanges:" target="-2" id="revertAction"/>
            </connections>
          </button>
          <button verticalHuggingPriority="750" identifier="save" id="save">
            <rect key="frame" x="985" y="677" width="100" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
            <buttonCell key="cell" type="push" title="Save" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="saveCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="save:" target="-2" id="saveAction"/>
            </connections>
          </button>
          <tabView identifier="stockTabs" id="stockTabs">
            <rect key="frame" x="13" y="10" width="1074" height="660"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <font key="font" metaFont="system"/>
            <tabViewItems>
              <tabViewItem label="Items" identifier="items" id="itemsTab">
                <view key="view" id="itemsView">
                  <rect key="frame" x="10" y="33" width="1054" height="614"/>
                  <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                  <subviews>
                    <searchField wantsLayer="YES" verticalHuggingPriority="750" identifier="itemSearch" id="itemSearch">
                      <rect key="frame" x="10" y="582" width="400" height="22"/>
                      <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                      <searchFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" usesSingleLineMode="YES" bezelStyle="round" sendsSearchStringImmediately="YES" id="itemSearchCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                      </searchFieldCell>
                      <connections>
                        <action selector="search:" target="-2" id="itemSearchAction"/>
                      </connections>
                    </searchField>
                    <scrollView autohidesScrollers="YES" hasHorizontalScroller="NO" horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" usesPredominantAxisScrolling="NO" id="itemsTableScroll">
                      <rect key="frame" x="10" y="48" width="400" height="526"/>
                      <autoresizingMask key="autoresizingMask" heightSizable="YES" flexibleMaxX="YES"/>
                      <clipView key="contentView" id="itemsTableClip">
                        <rect key="frame" x="1" y="1" width="398" height="524"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                          <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" headerView="itemsTableHeader" identifier="itemsTable" id="itemsTable">
                            <rect key="frame" x="0" y="0" width="398" height="501"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <size key="intercellSpacing" width="3" height="2"/>
                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                            <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                            <tableColumns>
                              <tableColumn identifier="sku" width="80" minWidth="30" maxWidth="1000" id="itemsTableSkuColumn">
                                <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="SKU">
                                  <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                </tableHeaderCell>
                                <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="itemsTableSkuCell">
                                  <font key="font" metaFont="system"/>
                                  <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                                <connections>
                                  <binding destination="items" name="value" keyPath="arrangedObjects.sku" id="itemsTableSkuValue"/>
                                </connections>
                              </tableColumn>
                              <tableColumn identifier="itemName" width="120" minWidth="30" maxWidth="1000" id="itemsTableItemNameColumn">
                                <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Item">
                                  <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                </tableHeaderCell>
                                <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" alignment="left" title="Text Cell" id="itemsTableItemNameCell">
                                  <font key="font" metaFont="system"/>
                                  <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                                <connections>
                                  <binding destination="items" name="value" keyPath="arrangedObjects.itemName" id="itemsTableItemNameValue"/>
                                </connections>
                              </tableColumn>
                              <tableColumn identifier="onHand" width="60" minWidth="30" maxWidth="1000" id="itemsTableOnHandColumn">
                                <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="On hand">
                                  <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                </tableHeaderCell>
                                <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="itemsTableOnHandCell">
                                  <numberFormatter key="formatter" formatterBehavior="custom10_4" generatesDecimalNumbers="YES" usesGroupingSeparator="NO" groupingSize="0" minimumIntegerDigits="1" maximumIntegerDigits="42" maximumFractionDigits="3" id="itemsTableOnHandFormatter"/>
                                  <font key="font" metaFont="system"/>
                                  <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                                <connections>
                                  <binding destination="items" name="value" keyPath="arrangedObjects.totalQuantity" id="itemsTableOnHandValue"/>
                                </connections>
                              </tableColumn>
                              <tableColumn identifier="available" width="60" minWidth="30" maxWidth="1000" id="itemsTableAvailableColumn">
                                <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Available">
                                  <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                </tableHeaderCell>
                                <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="itemsTableAvailableCell">
                                  <numberFormatter key="formatter" formatterBehavior="custom10_4" generatesDecimalNumbers="YES" usesGroupingSeparator="NO" groupingSize="0" minimumIntegerDigits="1" maximumIntegerDigits="42" maximumFractionDigits="3" id="itemsTableAvailableFormatter"/>
                                  <font key="font" metaFont="system"/>
                                  <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                  <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                                <connections>
                                  <binding destination="items" name="value" keyPath="arrangedObjects.available" id="itemsTableAvailableValue"/>
                                </connections>
                              </tableColumn>
                              <tableColumn identifier="incoming" width="60" minWidth="30" maxWidth="1000" id="itemsTableIncomingColumn">
                                <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Incoming">

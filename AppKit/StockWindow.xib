                <outlet property="contacts" destination="contacts" id="contactsOutlet"/>
                <outlet property="itemsTable" destination="itemsTable" id="itemsTableOutlet"/>
                <outlet property="warehousesTable" destination="warehousesTable" id="warehousesTableOutlet"/>
                <outlet property="locationsTable" destination="locationsTable" id="locationsTableOutlet"/>
                <outlet property="categoriesTable" destination="categoriesTable" id="categoriesTableOutlet"/>
                <outlet property="contactsTable" destination="contactsTable" id="contactsTableOutlet"/>
                <outlet property="saleOrders" destination="saleOrders" id="saleOrdersOutlet"/>
                <outlet property="saleLines" destination="saleLines" id="saleLinesOutlet"/>
                <outlet property="shipments" destination="shipments" id="shipmentsOutlet"/>

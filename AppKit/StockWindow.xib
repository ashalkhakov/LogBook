<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" customObjectInstantitationMethod="direct">
  <dependencies>
    <deployment identifier="macosx"/>
    <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
  </dependencies>
  <objects>
    <customObject id="-2" userLabel="File's Owner" customClass="LBStockWindowController">
      <connections>
        <outlet property="window" destination="window" id="windowOutlet"/>
        <outlet property="tabs" destination="stockTabs" id="tabsOutlet"/>
        <outlet property="itemList" destination="itemList" id="itemListOutlet"/>
        <outlet property="itemsTable" destination="itemsTable" id="itemsTableOutlet"/>
        <outlet property="itemSearch" destination="itemSearch" id="itemSearchOutlet"/>
        <outlet property="saleList" destination="saleList" id="saleListOutlet"/>
        <outlet property="purchaseList" destination="purchaseList" id="purchaseListOutlet"/>
        <outlet property="salesTable" destination="salesTable" id="salesTableOutlet"/>
        <outlet property="purchasesTable" destination="purchasesTable" id="purchasesTableOutlet"/>
        <outlet property="changeList" destination="changeList" id="changeListOutlet"/>
        <outlet property="countList" destination="countList" id="countListOutlet"/>
        <outlet property="openList" destination="openList" id="openListOutlet"/>
        <outlet property="openOrdersTable" destination="openOrdersTable" id="openOrdersTableOutlet"/>
      </connections>
    </customObject>
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
    <customObject id="-3" userLabel="Application" customClass="NSObject"/>
    <arrayController editable="YES" userLabel="Items" id="itemList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="items" id="itemListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Sales" id="saleList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="saleOrders" id="saleListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Purchases" id="purchaseList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="purchaseOrders" id="purchaseListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Changelog" id="changeList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="catalogChanges" id="changeListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Counts" id="countList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="catalogCounts" id="countListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="NO" userLabel="Count Adjustments" id="countMoveList">
      <connections>
        <binding destination="countList" name="contentSet" keyPath="selection.moves" id="countMoveListContent"/>
        <binding destination="-2" name="sortDescriptors" keyPath="byItem" id="countMoveListOrder"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Due" id="dueList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="rulesDue" id="dueListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Open Orders" id="openList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="ordersOpen" id="openListContent"/>
      </connections>
    </arrayController>
    <arrayController editable="YES" userLabel="Warehouses" id="warehouseList">
      <connections>
        <binding destination="-2" name="contentArray" keyPath="warehouses" id="warehouseListContent"/>
      </connections>
    </arrayController>
    <window title="Stock" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="LogbookStock" animationBehavior="default" id="window">
      <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
      <rect key="contentRect" x="180" y="140" width="1000" height="640"/>
      <rect key="screenRect" x="0" y="0" width="1920" height="1080"/>
      <value key="minSize" type="size" width="1000" height="640"/>
      <view key="contentView" id="content">
        <rect key="frame" x="0" y="0" width="1000" height="640"/>
        <autoresizingMask key="autoresizingMask"/>
        <subviews>
          <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" id="catalogLabel">
            <rect key="frame" x="14" y="606" width="60" height="17"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Catalog" id="catalogLabelCell">
              <font key="font" metaFont="system"/>
              <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
          </textField>
          <popUpButton verticalHuggingPriority="750" identifier="stockCatalog" id="stockCatalog">
            <rect key="frame" x="78" y="600" width="240" height="26"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="stockCatalogCell">
              <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
              <menu key="menu" id="stockCatalogMenu"/>
            </popUpButtonCell>
            <connections>
              <binding destination="-2" name="content" keyPath="catalogs" id="stockCatalogContent"/>
              <binding destination="-2" name="contentValues" keyPath="catalogs.lbTitle" previousBinding="stockCatalogContent" id="stockCatalogValues"/>
              <binding destination="-2" name="selectedObject" keyPath="catalog" previousBinding="stockCatalogValues" id="stockCatalogChosen"/>
            </connections>
          </popUpButton>
          <button verticalHuggingPriority="750" identifier="newCatalog" id="newCatalog">
            <rect key="frame" x="324" y="597" width="130" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <buttonCell key="cell" type="push" title="New Catalog" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="newCatalogCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="newCatalog:" target="-2" id="newCatalogAction"/>
            </connections>
          </button>
          <button verticalHuggingPriority="750" identifier="showSettings" id="showSettings">
            <rect key="frame" x="454" y="597" width="120" height="32"/>
            <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
            <buttonCell key="cell" type="push" title="Settings…" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="showSettingsCell">
              <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
              <font key="font" metaFont="system"/>
            </buttonCell>
            <connections>
              <action selector="showSettings:" target="-2" id="showSettingsAction"/>
            </connections>
          </button>
          <tabView identifier="stockTabs" id="stockTabs">
            <rect key="frame" x="13" y="10" width="974" height="580"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <font key="font" metaFont="system"/>
            <tabViewItems>
              <tabViewItem label="Items" identifier="items" id="itemsTab">

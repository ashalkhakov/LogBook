                        <subviews>
                          <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" headerView="itemsTableHeader" identifier="itemsTable" id="itemsTable">

<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="order-to-cash-definitions" targetNamespace="https://github.com/ashalkhakov/LogBook">
  <bpmn:import importType="http://schemas.neumont.edu/ORM/2006-04/ORMRoot" location="Logbook.orm" namespace="Logbook"/>
  <bpmn:import importType="http://schemas.ormkit.org/2026-10/Flows" location="Selling.flow" namespace="Selling"/>
  <bpmn:process id="orderToCash" name="Order to cash" isExecutable="true">
    <bpmn:documentation>A draft sale order, entered, to its goods shipped (docs/STOCK.md, Orders and Shipping). Its variable saleOrder is the order's id. A manager confirms it or cancels it, with the Selling flow's Confirm (its ConfirmSaleOrder form: the order's Confirm or Cancel); a keeper ships its goods with its Ship (ShipGoods: the order's Ship), as often as they go; once nothing is outstanding the order is closed.</bpmn:documentation>
    <bpmn:startEvent id="drafted" name="Draft made"/>
    <bpmn:userTask id="confirm" name="Confirm the order" camunda:candidateGroups="=[&quot;manager:&quot; + catalog]" camunda:formKey="ormkit:flow:Selling.flow#Confirm"/>
    <bpmn:exclusiveGateway id="confirmed" name="Confirmed?" default="toCancelled"/>
    <bpmn:endEvent id="cancelled" name="Cancelled"/>
    <bpmn:userTask id="ship" name="Ship the goods" camunda:candidateGroups="=[&quot;keeper:&quot; + catalog]" camunda:formKey="ormkit:flow:Selling.flow#Ship"/>
    <bpmn:serviceTask id="check" name="All shipped?" camunda:delegateExpression="${orderShipped}"/>
    <bpmn:exclusiveGateway id="shipped" name="All shipped?" default="toShipAgain"/>
    <bpmn:serviceTask id="close" name="Close the order" camunda:delegateExpression="${closeSaleOrder}"/>
    <bpmn:endEvent id="closed" name="Closed"/>
    <bpmn:sequenceFlow id="toConfirm" sourceRef="drafted" targetRef="confirm"/>
    <bpmn:sequenceFlow id="toConfirmed" sourceRef="confirm" targetRef="confirmed"/>
    <bpmn:sequenceFlow id="toShip" sourceRef="confirmed" targetRef="ship">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">orderState = "Confirmed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toCancelled" sourceRef="confirmed" targetRef="cancelled"/>
    <bpmn:sequenceFlow id="toCheck" sourceRef="ship" targetRef="check"/>
    <bpmn:sequenceFlow id="toShipped" sourceRef="check" targetRef="shipped"/>
    <bpmn:sequenceFlow id="toClose" sourceRef="shipped" targetRef="close">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fullyShipped = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toShipAgain" sourceRef="shipped" targetRef="ship"/>
    <bpmn:sequenceFlow id="toClosed" sourceRef="close" targetRef="closed"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="orderToCash_Diagram">
    <bpmndi:BPMNPlane id="orderToCash_Plane" bpmnElement="orderToCash">
      <bpmndi:BPMNShape id="drafted_Shape" bpmnElement="drafted">
        <dc:Bounds x="80" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="confirm_Shape" bpmnElement="confirm">
        <dc:Bounds x="170" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="confirmed_Shape" bpmnElement="confirmed" isMarkerVisible="true">
        <dc:Bounds x="320" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cancelled_Shape" bpmnElement="cancelled">
        <dc:Bounds x="327" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ship_Shape" bpmnElement="ship">
        <dc:Bounds x="420" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_Shape" bpmnElement="check">
        <dc:Bounds x="570" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipped_Shape" bpmnElement="shipped" isMarkerVisible="true">
        <dc:Bounds x="720" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="close_Shape" bpmnElement="close">
        <dc:Bounds x="820" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="closed_Shape" bpmnElement="closed">
        <dc:Bounds x="970" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toConfirm_Edge" bpmnElement="toConfirm">
        <di:waypoint x="116" y="120"/>
        <di:waypoint x="170" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toConfirmed_Edge" bpmnElement="toConfirmed">
        <di:waypoint x="270" y="120"/>
        <di:waypoint x="320" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toShip_Edge" bpmnElement="toShip">
        <di:waypoint x="370" y="120"/>
        <di:waypoint x="420" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toCancelled_Edge" bpmnElement="toCancelled">
        <di:waypoint x="345" y="145"/>
        <di:waypoint x="345" y="232"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toCheck_Edge" bpmnElement="toCheck">
        <di:waypoint x="520" y="120"/>
        <di:waypoint x="570" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toShipped_Edge" bpmnElement="toShipped">
        <di:waypoint x="670" y="120"/>
        <di:waypoint x="720" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toClose_Edge" bpmnElement="toClose">
        <di:waypoint x="770" y="120"/>
        <di:waypoint x="820" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toShipAgain_Edge" bpmnElement="toShipAgain">
        <di:waypoint x="745" y="145"/>
        <di:waypoint x="745" y="210"/>
        <di:waypoint x="470" y="210"/>
        <di:waypoint x="470" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toClosed_Edge" bpmnElement="toClosed">
        <di:waypoint x="920" y="120"/>
        <di:waypoint x="970" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

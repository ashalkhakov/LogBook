<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="supplier-return-definitions" targetNamespace="https://github.com/ashalkhakov/LogBook">
  <bpmn:import importType="http://schemas.neumont.edu/ORM/2006-04/ORMRoot" location="Logbook.orm" namespace="Logbook"/>
  <bpmn:import importType="http://schemas.ormkit.org/2026-10/Flows" location="Purchasing.flow" namespace="Purchasing"/>
  <bpmn:process id="supplierReturn" name="Supplier return" isExecutable="true">
    <bpmn:documentation>A supplier return asked for (docs/STOCK.md, Returns): so many of its purchase's lines to go back, nothing moved yet. Its variable supplierReturn is the return's id. A keeper of its catalog sends it with the Purchasing flow's SendReturn (its SendSupplierReturn form): returned, its moves made out of where it went from, or cancelled.</bpmn:documentation>
    <bpmn:startEvent id="requested" name="Asked for"/>
    <bpmn:userTask id="send" name="Send the return" camunda:candidateGroups="=[&quot;keeper:&quot; + catalog]" camunda:formKey="ormkit:flow:Purchasing.flow#SendReturn"/>
    <bpmn:endEvent id="returned" name="Returned"/>
    <bpmn:sequenceFlow id="toDo" sourceRef="requested" targetRef="send"/>
    <bpmn:sequenceFlow id="toReturned" sourceRef="send" targetRef="returned"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="supplierReturn_Diagram">
    <bpmndi:BPMNPlane id="supplierReturn_Plane" bpmnElement="supplierReturn">
      <bpmndi:BPMNShape id="requested_Shape" bpmnElement="requested">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_Shape" bpmnElement="send">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="returned_Shape" bpmnElement="returned">
        <dc:Bounds x="392" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toDo_Edge" bpmnElement="toDo">
        <di:waypoint x="188" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toReturned_Edge" bpmnElement="toReturned">
        <di:waypoint x="340" y="120"/>
        <di:waypoint x="392" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

			<orm:EntityType id="_B658AD26-934B-4C9A-AE40-5F53A06EAECB" Name="Move" _ReferenceMode="id">
				<orm:Notes>
					<orm:Note id="_2F1E3D5E-929B-4352-B99A-B653C1135999">
						<orm:Text>A move: so many of an item, from a location, to a location, or both (a
transfer); with no source it came in, with no destination it went out.
What made it: a receipt or a shipment, or an adjustment and why; and who.</orm:Text>
					</orm:Note>
				</orm:Notes>
				<orm:PlayedRoles>
					<orm:Role ref="_E18BB2A1-0EE6-4A85-A6DF-D0288EBB7322" />

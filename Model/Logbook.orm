			<orm:EntityType id="_11F9C7D7-974F-4F63-8F5A-226C6CC88F1B" Name="Assembly" _ReferenceMode="id">
				<orm:Notes>
					<orm:Note id="_4556D197-A2C1-40C4-9C82-A7637F4CCD35">
						<orm:Text>An assembly: so many batches of a kit made at a location on a day, its
components moved out and the kit in; a disassembly the other way round.</orm:Text>
					</orm:Note>
				</orm:Notes>
				<orm:PlayedRoles>

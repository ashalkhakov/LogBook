						<orm:InformalRule>
							<orm:DerivationNote id="_9D5BE663-F617-4F24-AEAC-68552C493091">
								<orm:Body>For each Record, Amount and Currency, that Record cost the Money of Amount and Currency if that Record is an Event that is a MeteredEvent that is a Service that is paid in that Currency and some ServiceItem is part of that Service that possibly had a discount of some Money2 that has some Amount2 and that ServiceItem cost some Money1 that has some Amount1 and Money1 is in that Currency and Items is the total of Amount1 for that Record and Amount is Items minus Amount2, or 0 where there is none.</orm:Body>
							</orm:DerivationNote>
						</orm:InformalRule>
					</orm:FactTypeDerivationPath>
				</orm:DerivationRule>
			</orm:Fact>

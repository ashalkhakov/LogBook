										<orm:PathedRole ref="_1EDBE4CD-F4F7-A3F7-E97A-F223A6590170" />
									</orm:DerivationSource>
								</orm:RoleProjection>
							</orm:DerivationProjection>
						</orm:DerivationProjections>
						<orm:InformalRule>
							<orm:DerivationNote id="_F86D3E04-3DC3-4ECE-9092-8C36BCA26EBA">
								<orm:Body>For each TyreChange1 and TyreSet, TyreChange1 removed that TyreSet if and only if TyreChange1 was at some Moment1 and is of some Vehicle and some Record1 is of that Vehicle and Record1 is an Event1 that is a MeteredEvent1 that is a TyreChange2 that was at some Moment2 and some Record2 is of that Vehicle and Record2 is an Event2 that is a MeteredEvent2 that is a TyreChange3 that was at some Moment3 and TyreChange3 fitted that TyreSet and Moment2 is less than Moment1 and Moment3 is Previous and Previous is the maximum of Moment2 for TyreChange1.</orm:Body>
							</orm:DerivationNote>
						</orm:InformalRule>
					</orm:FactTypeDerivationPath>
				</orm:DerivationRule>
			</orm:Fact>

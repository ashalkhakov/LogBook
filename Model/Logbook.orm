			<orm:EntityType id="_E88A7609-676C-4DAF-BAEE-E24029F2E40A" Name="Shipment" _ReferenceMode="id">
				<orm:Notes>
					<orm:Note id="_591B0BE5-F520-4C73-999C-8EB7C1E6343A">
						<orm:Text>A shipment: what went out of a sale order at once, on a day, from a
location; a sale order may go out in several. Each of its moves ships a
line, some or all of it.</orm:Text>
					</orm:Note>
				</orm:Notes>

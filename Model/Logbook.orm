						<orm:ValueRanges>
							<orm:ValueRange id="_21ADBC1E-7BAC-4A2A-963C-E8D4B4DF829B" MinValue="Draft" MaxValue="Draft" MinInclusion="NotSet" MaxInclusion="NotSet" />

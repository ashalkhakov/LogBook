						</orm:DerivationProjections>
						<orm:InformalRule>
							<orm:DerivationNote id="_1C9B4962-B453-47A9-932D-9D7E1C9CD5DA">
								<orm:Body>For each SaleLine1 and Quantity, SaleLine1 has shipped Quantity in its components if and only if SaleLine1 is for some StockItem1 that possibly is made in batches of some Quantity1 and some SaleLine2 is part of SaleLine1 and possibly SaleLine2 has shipped some Quantity2 and SaleLine2 is for some StockItem2 and some KitLine is for StockItem2 and that KitLine is of StockItem1 and that KitLine is for some Quantity3 and Batches is the whole part of (Quantity2, or 0 where there is none divided by Quantity3) and Fewest is the minimum of Batches for SaleLine1 and Quantity is Fewest times Quantity1, or 1 where there is none.</orm:Body>
							</orm:DerivationNote>
						</orm:InformalRule>
					</orm:FactTypeDerivationPath>
				</orm:DerivationRule>
			</orm:Fact>

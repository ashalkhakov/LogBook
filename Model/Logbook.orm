			<orm:Fact id="_7DD39AB5-0F8E-4893-A77D-656969C16EE7" _Name="ReminderIsCountedFromDate">
				<orm:Notes>
					<orm:Note id="_9F808914-6EC1-40D6-B6ED-A384E4AD895E">
						<orm:Text>Where a schedule's reminder is counted from: the day and the odometer
reading of what did the reminder before (or of the last time the work
was done, as the schedule was started), its intervals added to them for
when it is due; counted again when the schedule goes on in another.</orm:Text>
					</orm:Note>
				</orm:Notes>

						<orm:InformalRule>
							<orm:DerivationNote id="_C40F6D48-51F0-4E28-81DC-7AA2B2159A4E">
								<orm:Body>For each StockItem and Quantity, that StockItem has available Quantity if and only if possibly that StockItem totals some Quantity1 and possibly has committed some Quantity2 and Quantity is Quantity1, or 0 where there is none minus Quantity2, or 0 where there is none and Quantity is greater than 0.</orm:Body>
							</orm:DerivationNote>

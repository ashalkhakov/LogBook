						<orm:InformalRule>
							<orm:DerivationNote id="_A7322BDC-27A8-4922-8CAF-DFDBA68BF2BF">
								<orm:Body>For each StockItem and Quantity, that StockItem totals Quantity if and only if some Holding is of that StockItem and that Holding has some Quantity and Quantity is the total of that Quantity for that StockItem.</orm:Body>
							</orm:DerivationNote>
						</orm:InformalRule>
					</orm:FactTypeDerivationPath>

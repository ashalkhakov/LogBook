		<ormq:Query id="_BF667244-BEDD-4338-83DE-9EF456B1190C" Name="MeterGoesUp" Kind="Constraint" Modality="Deontic">
			<ormq:Note>The meter goes up: a vehicle's later reading, in kilometres whatever

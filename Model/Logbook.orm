						<orm:InformalRule>
							<orm:DerivationNote id="_B61E658D-47C8-4972-901F-B03D516AAE6E">
								<orm:Body>For each Holding and Quantity, that Holding has Quantity if and only if that Holding is of some StockItem and is at some Location and possibly some Move1 is to that Location and Move1 is of that StockItem and Move1 is of some Quantity1 and possibly some Move2 is from that Location and Move2 is of that StockItem and Move2 is of some Quantity2 and In is the total of Quantity1 for that Holding and Out is the total of Quantity2 for that Holding and Quantity is In, or 0 where there is none minus Out, or 0 where there is none.</orm:Body>
							</orm:DerivationNote>
						</orm:InformalRule>
					</orm:FactTypeDerivationPath>
				</orm:DerivationRule>
			</orm:Fact>

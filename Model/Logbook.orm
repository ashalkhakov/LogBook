			<orm:EqualityConstraint id="_64EAB4E3-D99E-4FBF-A3BA-50774D2F6D0F" Name="EqualityConstraint4">
				<orm:Notes>
					<orm:Note id="_41875DD7-AB8B-41A3-9B5F-0B31B0E14206">
						<orm:Text>A receipt's moves receive its order's lines, of their items, into where
it was received; a shipment's ship its order's lines, of their items,
out of where it was shipped from. A move is of one order at most, or an
adjustment.</orm:Text>
					</orm:Note>
				</orm:Notes>

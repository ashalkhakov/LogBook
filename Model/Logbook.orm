			<orm:ValueType id="_5EA270A5-C6C1-4304-815D-FAC75132E16C" Name="ContactName">
				<orm:Notes>
					<orm:Note id="_B8D058FB-D684-4DE5-B0DF-A3D841489FDA">
						<orm:Text>A contact: a person or a company a catalog deals with, how to reach it,
where it is. Being a customer or a supplier of its catalog is a part it
plays; a company that is both is one contact.</orm:Text>
					</orm:Note>
				</orm:Notes>
				<orm:PlayedRoles>

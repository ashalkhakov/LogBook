						<orm:InformalRule>
							<orm:DerivationNote id="_9A53538D-85AD-4309-85B1-BA707B3F4F65">
								<orm:Body>For each StockItem1 and Quantity, StockItem1 can make Quantity if and only if possibly StockItem1 is made in batches of some Quantity1 and some KitLine is of StockItem1 and that KitLine is for some Quantity2 and that KitLine is for some StockItem2 that possibly totals some Quantity3 and Batches is the whole part of (Quantity3, or 0 where there is none divided by Quantity2) and Fewest is the minimum of Batches for StockItem1 and Quantity is Fewest times Quantity1, or 1 where there is none.</orm:Body>
							</orm:DerivationNote>
						</orm:InformalRule>
					</orm:FactTypeDerivationPath>
				</orm:DerivationRule>

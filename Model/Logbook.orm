			<orm:EntityType id="_56CBBF38-F276-4384-80B3-22ECD8F9F6E6" Name="Receipt" _ReferenceMode="id">
				<orm:Notes>
					<orm:Note id="_C6F72633-5C9E-4D4D-9BC1-6C3F7E289FD6">
						<orm:Text>A receipt: what came in of a purchase order at once, on a day, at a
location; a purchase order may come in several. Each of its moves
receives a line, some or all of it.</orm:Text>
					</orm:Note>
				</orm:Notes>
				<orm:PlayedRoles>
					<orm:Role ref="_2303F589-7710-4EB3-BA6B-BD4F606124A7" />

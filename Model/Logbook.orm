			<orm:Fact id="_B39A3DC6-9B7B-46C7-A113-E52FF78139D6" _Name="HoldingHasQuantity">
				<orm:Notes>
					<orm:Note id="_EE484EC1-7DEA-40E0-88F3-AC8AF21C7AFD">
						<orm:Text>A holding: what its item's moves leave at its location, those in less
those out; stored. Never below none: a move out of more than is there
is refused. Every move's item has a holding where it goes and where it
comes from.</orm:Text>
					</orm:Note>
				</orm:Notes>

			<orm:ValueType id="_87AAA1C2-C607-485A-A3C7-9190F6BB24F5" Name="OrderState">
				<orm:Notes>
					<orm:Note id="_DBF00D60-DF1E-4F03-B928-D7CFA15E2454">
						<orm:Text>An order's state, as its user decides it: a draft, confirmed (to be
filled), closed (done with, whatever is left), or cancelled. How far it
is filled is worked out from its lines.</orm:Text>
					</orm:Note>
				</orm:Notes>
				<orm:PlayedRoles>
					<orm:Role ref="_D893665E-C933-47C1-8A25-133FEB01A781" />
					<orm:Role ref="_6DA6E0B6-D40B-4A60-994C-EB3B96D1AB0E" />
				</orm:PlayedRoles>

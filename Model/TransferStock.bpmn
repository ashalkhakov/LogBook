<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="transfer-stock-definitions" targetNamespace="https://github.com/ashalkhakov/LogBook">
  <bpmn:import importType="http://schemas.neumont.edu/ORM/2006-04/ORMRoot" location="Logbook.orm" namespace="Logbook"/>
  <bpmn:import importType="http://schemas.ormkit.org/2026-10/Flows" location="Transferring.flow" namespace="Transferring"/>
  <bpmn:process id="transferStock" name="Transfer stock" isExecutable="true">
    <bpmn:documentation>A transfer asked for (docs/STOCK.md, Moves): so many of an item to go from one place to another, nothing moved yet. Its variable stockTransfer is the transfer's id, fromWarehouse the warehouse it goes from. A keeper there moves it with the Transferring flow's Move (its MoveStock form): moved, its move made, or cancelled.</bpmn:documentation>
    <bpmn:startEvent id="requested" name="Asked for"/>
    <bpmn:userTask id="move" name="Move the stock" camunda:candidateGroups="=[&quot;keeperAt:&quot; + fromWarehouse]" camunda:formKey="ormkit:flow:Transferring.flow#Move"/>
    <bpmn:endEvent id="moved" name="Moved"/>
    <bpmn:sequenceFlow id="toMove" sourceRef="requested" targetRef="move"/>
    <bpmn:sequenceFlow id="toMoved" sourceRef="move" targetRef="moved"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="transferStock_Diagram">
    <bpmndi:BPMNPlane id="transferStock_Plane" bpmnElement="transferStock">
      <bpmndi:BPMNShape id="requested_Shape" bpmnElement="requested">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="move_Shape" bpmnElement="move">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="moved_Shape" bpmnElement="moved">
        <dc:Bounds x="392" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toMove_Edge" bpmnElement="toMove">
        <di:waypoint x="188" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toMoved_Edge" bpmnElement="toMoved">
        <di:waypoint x="340" y="120"/>
        <di:waypoint x="392" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

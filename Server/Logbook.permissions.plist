// Who may see and change what, and call which actions, as relations
// (ODataKit's docs/permissions.md): the server loads it once a sign-in is
// set, and the build checks it against the model (odatakit-permissions
// check). A set it does not name is read only (LBPermissions.h).
//
// Vehicles (docs/CSDP.md, Permissions): a user sees the vehicles they
// drive (own, or are entered as a driver of: VehicleDriver), and what is
// of them. A vehicle is made by anyone signed in, its owner; only its
// owner changes or removes it, who drives it and its valuations. A record
// is added by whoever drives its vehicle; only the owner changes or
// removes one. A record's items, attachments and answers go with it:
// added with a new record (one made in the same change set decides by its
// own insert), else its owner's. A checklist is its keeper's, seen too by whoever an inspection
// of a vehicle of theirs went through it. Units are the app's; exchange
// rates and kinds of cost are added by anyone signed in, changed by no
// one. Users are seen and written as LBPermissions.h says (a write finds
// anyone by email, which no relation can say); changed only by themselves.
//
// Stock (docs/STOCK.md, Who may): a catalog is its owner's; a warehouse's staff (WarehouseStaff, as
// Manager or Keeper) manage or keep it. Everything of a catalog is seen
// by its owner and any warehouse's staff. The owner alone writes the
// catalog's items, contacts, warehouses and staff; a manager of any of
// its warehouses its orders, of a warehouse its locations and reorder
// rules; a keeper of a warehouse what moves stock there, which a manager
// there changes or removes.
//
// A relation's terms are joined with or; all = ( ... ) is and (a move
// kept at both its ends; a parts sale, by a keeper where it ships from).
{
  Version = 1;
  Identities = ( sub, email );

  Tuples = {
    WarehouseStaff = { object = warehouse; relation = staffRole; user = "user.email"; };
    VehicleDriver  = { object = vehicle; relationName = Driver; user = "user.email"; };
  };

  Entities = {
    Vehicle = {
      owner  = ( { where = "owner.email IN $user"; } );
      Driver = ( { direct = YES; } );
      driver = ( { relation = owner; }, { relation = Driver; } );
      read   = ( { relation = driver; } );
      // Anyone signed in makes one, theirs (the handler names them owner).
      insert = ( { where = "$user.@count > 0"; } );
      update = ( { relation = owner; } );
      delete = ( { relation = owner; } );
    };
    VehicleDriver = {
      read   = ( { relation = driver; from = vehicle; } );
      insert = ( { relation = owner; from = vehicle; } );
      update = ( { relation = owner; from = vehicle; } );
      delete = ( { relation = owner; from = vehicle; } );
    };
    VehicleWasValuedOnDateAtMoney = {
      read   = ( { relation = driver; from = vehicle; } );
      insert = ( { relation = owner; from = vehicle; } );
      update = ( { relation = owner; from = vehicle; } );
      delete = ( { relation = owner; from = vehicle; } );
    };
    // Every record: events, schedules, reminders.
    Record = {
      owner  = ( { relation = owner; from = vehicle; } );
      driver = ( { relation = driver; from = vehicle; } );
      read   = ( { relation = driver; } );
      insert = ( { relation = driver; } );
      update = ( { relation = owner; } );
      delete = ( { relation = owner; } );
      // The procedures (LBActions.h): a schedule started and continued, a
      // reminder cancelled, a record discarded, by the owner; a reminder
      // completed and rescheduled by whoever drives the vehicle.
      "call.Start"      = ( { relation = owner; } );
      "call.Continue"   = ( { relation = owner; } );
      "call.Cancel"     = ( { relation = owner; } );
      "call.Discard"    = ( { relation = owner; } );
      "call.Complete"   = ( { relation = driver; } );
      "call.Reschedule" = ( { relation = driver; } );
    };
    ServiceItem = {
      read   = ( { relation = read; from = service; } );
      insert = ( { relation = owner; from = service; } );
      update = ( { relation = owner; from = service; } );
      delete = ( { relation = owner; from = service; } );
    };
    Answer = {
      read   = ( { relation = read; from = inspection; } );
      insert = ( { relation = owner; from = inspection; } );
      update = ( { relation = owner; from = inspection; } );
      delete = ( { relation = owner; from = inspection; } );
    };
    // A record's photo, or a stock item's (its catalog's owner's).
    Attachment = {
      read   = ( { relation = read; from = record; }, { relation = read; from = stockItem; } );
      insert = ( { relation = owner; from = record; }, { relation = owner; from = stockItem; } );
      update = ( { relation = owner; from = record; }, { relation = owner; from = stockItem; } );
      delete = ( { relation = owner; from = record; }, { relation = owner; from = stockItem; } );
    };
    Rescheduling = {
      read   = ( { relation = driver; from = reminder; } );
      insert = ( { relation = driver; from = reminder; } );
      update = ( { relation = owner; from = reminder; } );
      delete = ( { relation = owner; from = reminder; } );
    };
    Checklist = {
      keeper = ( { where = "user.email IN $user"; } );
      read   = ( { relation = keeper; }, { relation = driver; from = inspections; } );
      // Anyone signed in keeps one (the handler names them its keeper).
      insert = ( { where = "$user.@count > 0"; } );
      update = ( { relation = keeper; } );
      delete = ( { relation = keeper; } );
    };
    Question = {
      keeper = ( { relation = keeper; from = checklist; } );
      read   = ( { relation = read; from = checklist; } );
      insert = ( { relation = keeper; } );
      update = ( { relation = keeper; } );
      delete = ( { relation = keeper; } );
    };
    Option = {
      read   = ( { relation = read; from = question; } );
      insert = ( { relation = keeper; from = question; } );
      update = ( { relation = keeper; from = question; } );
      delete = ( { relation = keeper; from = question; } );
    };
    User = {
      update = ( { where = "email IN $user"; } );
      delete = ( { where = "email IN $user"; } );
    };
    DistanceUnit = { insert = ( ); update = ( ); delete = ( ); };
    VolumeUnit   = { insert = ( ); update = ( ); delete = ( ); };
    SizeUnit     = { insert = ( ); update = ( ); delete = ( ); };
    WeightUnit   = { insert = ( ); update = ( ); delete = ( ); };
    CostKind     = { insert = ( { where = "$user.@count > 0"; } ); update = ( ); delete = ( ); };
    ExchangeRate = { insert = ( { where = "$user.@count > 0"; } ); update = ( ); delete = ( ); };

    Catalog = {
      owner   = ( { where = "catalogOwner.email IN $user"; } );
      manager = ( { relation = owner; }, { relation = manager; from = warehouses; } );
      keeper  = ( { relation = manager; }, { relation = keeper; from = warehouses; } );
      read    = ( { relation = keeper; } );
      // Anyone signed in makes one, theirs (the handler names them owner).
      insert  = ( { where = "$user.@count > 0"; } );
      update  = ( { relation = owner; } );
      delete  = ( { relation = owner; } );
    };

    Warehouse = {
      owner   = ( { relation = owner; from = catalog; } );
      Manager = ( { direct = YES; } );
      Keeper  = ( { direct = YES; } );
      manager = ( { relation = Manager; }, { relation = owner; } );
      keeper  = ( { relation = Keeper; }, { relation = manager; } );
      read    = ( { relation = read; from = catalog; } );
      insert  = ( { relation = owner; } );
      update  = ( { relation = owner; } );
      delete  = ( { relation = owner; } );
      "call.Count"   = ( { relation = keeper; } );
      "call.Reorder" = ( { relation = manager; } );
    };
    WarehouseStaff = {
      read   = ( { relation = read; from = warehouse; } );
      insert = ( { relation = owner; from = warehouse; } );
      update = ( { relation = owner; from = warehouse; } );
      delete = ( { relation = owner; from = warehouse; } );
    };

    // The owner's: the catalog's items, its contacts and what is of them.
    StockItem = {
      owner  = ( { relation = owner; from = catalog; } );
      read   = ( { relation = read; from = catalog; } );
      insert = ( { relation = owner; } );
      update = ( { relation = owner; } );
      delete = ( { relation = owner; } );
      // The procedures (LBStockActions.h): what an action moves is checked
      // in it too, where it moves it (keeper there).
      "call.Transfer" = ( { relation = keeper; from = catalog; } );
      "call.Adjust"   = ( { relation = keeper; from = catalog; } );
      "call.Assemble" = ( { relation = keeper; from = catalog; } );
    };
    Category = {
      read   = ( { relation = read; from = catalog; } );
      insert = ( { relation = owner; from = catalog; } );
      update = ( { relation = owner; from = catalog; } );
      delete = ( { relation = owner; from = catalog; } );
    };
    ItemAttribute = {
      read   = ( { relation = read; from = catalog; } );
      insert = ( { relation = owner; from = catalog; } );
      update = ( { relation = owner; from = catalog; } );
      delete = ( { relation = owner; from = catalog; } );
    };
    Supplier = {
      read   = ( { relation = read; from = catalog; } );
      insert = ( { relation = owner; from = catalog; } );
      update = ( { relation = owner; from = catalog; } );
      delete = ( { relation = owner; from = catalog; } );
    };
    // A vehicle owner's contact and customer, for the parts their
    // services use: made by the catalog's warehouse staff too.
    Contact = {
      owner  = ( { relation = owner; from = catalog; } );
      read   = ( { relation = read; from = catalog; } );
      insert = ( { relation = owner; },
                 { all = ( { where = "user != nil"; }, { relation = keeper; from = catalog; } ); } );
      update = ( { relation = owner; } );
      delete = ( { relation = owner; } );
    };
    Customer = {
      read   = ( { relation = read; from = catalog; } );
      insert = ( { relation = owner; from = catalog; },
                 { all = ( { where = "contact.user != nil"; }, { relation = keeper; from = catalog; } ); } );
      update = ( { relation = owner; from = catalog; } );
      delete = ( { relation = owner; from = catalog; } );
    };
    Address = {
      read   = ( { relation = read; from = contact; } );
      insert = ( { relation = owner; from = contact; } );
      update = ( { relation = owner; from = contact; } );
      delete = ( { relation = owner; from = contact; } );
    };
    ItemAttributeValue = {
      read   = ( { relation = read; from = stockItem; } );
      insert = ( { relation = owner; from = stockItem; } );
      update = ( { relation = owner; from = stockItem; } );
      delete = ( { relation = owner; from = stockItem; } );
    };
    KitLine = {
      read   = ( { relation = read; from = kit; } );
      insert = ( { relation = owner; from = kit; } );
      update = ( { relation = owner; from = kit; } );
      delete = ( { relation = owner; from = kit; } );
    };
    SupplierItem = {
      read   = ( { relation = read; from = stockItem; } );
      insert = ( { relation = owner; from = stockItem; } );
      update = ( { relation = owner; from = stockItem; } );
      delete = ( { relation = owner; from = stockItem; } );
    };
    ItemCode = {
      read   = ( { relation = read; from = stockItem; } );
      insert = ( { relation = owner; from = stockItem; } );
      update = ( { relation = owner; from = stockItem; } );
      delete = ( { relation = owner; from = stockItem; } );
    };

    // A warehouse's managers': its locations and reorder rules.
    Location = {
      manager = ( { relation = manager; from = warehouse; } );
      keeper  = ( { relation = keeper; from = warehouse; } );
      read    = ( { relation = read; from = warehouse; } );
      insert  = ( { relation = manager; } );
      update  = ( { relation = manager; } );
      delete  = ( { relation = manager; } );
    };
    ReorderRule = {
      read   = ( { relation = read; from = warehouse; } );
      insert = ( { relation = manager; from = warehouse; } );
      update = ( { relation = manager; from = warehouse; } );
      delete = ( { relation = manager; from = warehouse; } );
    };

    // Orders: any of the catalog's managers'. A service's or tyre
    // change's parts sale, and its lines: a keeper's where it ships from.
    SaleOrder = {
      manager = ( { relation = manager; from = catalog; } );
      parts   = ( { all = ( { where = "serviceAsPartsSale != nil OR tyreChangeAsPartsSale != nil"; },
                            { relation = keeper; from = shipsFrom; } ); } );
      read    = ( { relation = read; from = catalog; } );
      insert  = ( { relation = manager; }, { relation = parts; } );
      update  = ( { relation = manager; }, { relation = parts; } );
      delete  = ( { relation = manager; }, { relation = parts; } );
      "call.Confirm"    = ( { relation = manager; } );
      "call.Close"      = ( { relation = manager; } );
      "call.Cancel"     = ( { relation = manager; } );
      "call.Reopen"     = ( { relation = manager; } );
      "call.ExpandKits" = ( { relation = manager; } );
      // The procedures (LBStockActions.h): what an action moves is checked
      // in it too, where it moves it (keeper there).
      "call.Ship"   = ( { relation = keeper; from = catalog; } );
      "call.Return" = ( { relation = keeper; from = catalog; } );
    };
    SaleLine = {
      read   = ( { relation = read; from = saleOrder; } );
      insert = ( { relation = manager; from = saleOrder; }, { relation = parts; from = saleOrder; } );
      update = ( { relation = manager; from = saleOrder; }, { relation = parts; from = saleOrder; } );
      delete = ( { relation = manager; from = saleOrder; }, { relation = parts; from = saleOrder; } );
    };
    PurchaseOrder = {
      manager = ( { relation = manager; from = catalog; } );
      read    = ( { relation = read; from = catalog; } );
      insert  = ( { relation = manager; } );
      update  = ( { relation = manager; } );
      delete  = ( { relation = manager; } );
      "call.Confirm" = ( { relation = manager; } );
      "call.Close"   = ( { relation = manager; } );
      "call.Cancel"  = ( { relation = manager; } );
      "call.Reopen"  = ( { relation = manager; } );
      // The procedures (LBStockActions.h): what an action moves is checked
      // in it too, where it moves it (keeper there).
      "call.Receive" = ( { relation = keeper; from = catalog; } );
      "call.Return"  = ( { relation = keeper; from = catalog; } );
    };
    PurchaseLine = {
      read   = ( { relation = read; from = purchaseOrder; } );
      insert = ( { relation = manager; from = purchaseOrder; } );
      update = ( { relation = manager; from = purchaseOrder; } );
      delete = ( { relation = manager; from = purchaseOrder; } );
    };

    // What moves stock: made by a keeper where it is, changed or removed
    // by a manager there.
    Holding = {
      read   = ( { relation = read; from = stockItem; } );
      insert = ( { relation = keeper; from = location; } );
      update = ( { relation = manager; from = location; } );
      delete = ( { relation = manager; from = location; } );
    };
    // A move is kept at both its ends (a transfer between warehouses
    // needs both); one end of it, at that end.
    Move = {
      read   = ( { relation = read; from = stockItem; } );
      insert = ( { all = ( { relation = keeper; from = source; }, { relation = keeper; from = destination; } ); },
                 { all = ( { where = "source == nil"; }, { relation = keeper; from = destination; } ); },
                 { all = ( { where = "destination == nil"; }, { relation = keeper; from = source; } ); } );
      update = ( { all = ( { relation = manager; from = source; }, { relation = manager; from = destination; } ); },
                 { all = ( { where = "source == nil"; }, { relation = manager; from = destination; } ); },
                 { all = ( { where = "destination == nil"; }, { relation = manager; from = source; } ); } );
      delete = ( { all = ( { relation = manager; from = source; }, { relation = manager; from = destination; } ); },
                 { all = ( { where = "source == nil"; }, { relation = manager; from = destination; } ); },
                 { all = ( { where = "destination == nil"; }, { relation = manager; from = source; } ); } );
    };
    Shipment = {
      read   = ( { relation = read; from = saleOrder; } );
      insert = ( { relation = keeper; from = shippedFrom; } );
      update = ( { relation = manager; from = shippedFrom; } );
      delete = ( { relation = manager; from = shippedFrom; } );
    };
    Receipt = {
      read   = ( { relation = read; from = purchaseOrder; } );
      insert = ( { relation = keeper; from = receivedAt; } );
      update = ( { relation = manager; from = receivedAt; } );
      delete = ( { relation = manager; from = receivedAt; } );
    };
    CustomerReturn = {
      read   = ( { relation = read; from = saleOrder; } );
      insert = ( { relation = keeper; from = returnedTo; } );
      update = ( { relation = manager; from = returnedTo; } );
      delete = ( { relation = manager; from = returnedTo; } );
    };
    SupplierReturn = {
      read   = ( { relation = read; from = purchaseOrder; } );
      insert = ( { relation = keeper; from = returnedFrom; } );
      update = ( { relation = manager; from = returnedFrom; } );
      delete = ( { relation = manager; from = returnedFrom; } );
    };
    Assembly = {
      read   = ( { relation = read; from = assembled; } );
      insert = ( { relation = keeper; from = assembledAt; } );
      update = ( { relation = manager; from = assembledAt; } );
      delete = ( { relation = manager; from = assembledAt; } );
    };
    StockCount = {
      read   = ( { relation = read; from = warehouse; } );
      insert = ( { relation = keeper; from = warehouse; } );
      update = ( { relation = manager; from = warehouse; } );
      delete = ( { relation = manager; from = warehouse; } );
    };
  };
}

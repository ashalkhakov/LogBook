                        </SortExpressions>
                        <ChartCategoryHierarchy>
                            <ChartMembers>
                                <ChartMember>
                                    <Group Name="CostsChart_Category">
                                        <GroupExpressions>
                                            <GroupExpression>=Fields!Month.Value</GroupExpression>
                                        </GroupExpressions>
                                    </Group>
                                    <Label>=Format(Fields!Month.Value, "MMM yy")</Label>
                                </ChartMember>
                            </ChartMembers>
                        </ChartCategoryHierarchy>
                        <ChartSeriesHierarchy>
                            <ChartMembers>
                                <ChartMember>
                                    <Group Name="CostsChart_Series">

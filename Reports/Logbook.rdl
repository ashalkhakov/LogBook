<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <rd:ReportName>Logbook</rd:ReportName>
    <Description>What was recorded of a vehicle, day by day, and how much of each kind.</Description>
    <Author>Logbook</Author>
    <DataSources>
        <DataSource Name="Logbook">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"Records":[{"Cost":69.8,"Currency":"EUR","Driver":"Anna","Kind":"Fill-up","Note":"","When":"2026-09-09T07:55:00"},{"Cost":240.0,"Currency":"EUR","Driver":"Anna","Kind":"Service","Note":"Oil and filters","When":"2026-09-14T10:00:00"},{"Cost":12.5,"Currency":"EUR","Driver":"Ben","Kind":"Expense","Note":"Parking","When":"2026-09-20T12:30:00"},{"Driver":"Ben","Kind":"Trip","Note":"To the coast","When":"2026-09-22T09:00:00"}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Records">
            <Query>
                <DataSourceName>Logbook</DataSourceName>
                <CommandText>$.Records[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Kind">
                    <DataField>Kind</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
                <Field Name="When">
                    <DataField>When</DataField>
                    <rd:TypeName>System.DateTime</rd:TypeName>
                </Field>
                <Field Name="Cost">
                    <DataField>Cost</DataField>
                    <rd:TypeName>System.Decimal</rd:TypeName>
                </Field>
                <Field Name="Currency">
                    <DataField>Currency</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
                <Field Name="Driver">
                    <DataField>Driver</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
                <Field Name="Note">
                    <DataField>Note</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
            </Fields>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="Vehicle">
            <DataType>String</DataType>
            <Nullable>true</Nullable>
            <AllowBlank>true</AllowBlank>
            <Prompt>Vehicle</Prompt>
            <DefaultValue>
                <Values>
                    <Value>Golf</Value>

<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <rd:ReportName>Fuel</rd:ReportName>
    <Description>A vehicle's fill-ups: what each cost, a unit's price, and the consumption at each full tank.</Description>
    <Author>Logbook</Author>
    <DataSources>
        <DataSource Name="Logbook">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"FillUps":[{"Cost":70.0,"Currency":"EUR","DistanceUnit":"km","Full":"YES","Odometer":12000,"Price":1.699,"Station":"Shell","Volume":41.2,"VolumeUnit":"L","When":"2026-08-02T08:10:00"},{"Consumption":6.17,"Cost":66.4,"Currency":"EUR","DistanceUnit":"km","Full":"YES","Odometer":12640,"Price":1.681,"Station":"Aral","Volume":39.5,"VolumeUnit":"L","When":"2026-08-20T18:40:00"},{"Consumption":6.28,"Cost":69.8,"Currency":"EUR","DistanceUnit":"km","Full":"YES","Odometer":13290,"Price":1.711,"Station":"Shell","Volume":40.8,"VolumeUnit":"L","When":"2026-09-09T07:55:00"}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="FillUps">
            <Query>
                <DataSourceName>Logbook</DataSourceName>
                <CommandText>$.FillUps[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="When">
                    <DataField>When</DataField>
                    <rd:TypeName>System.DateTime</rd:TypeName>
                </Field>
                <Field Name="Odometer">
                    <DataField>Odometer</DataField>
                    <rd:TypeName>System.Decimal</rd:TypeName>
                </Field>
                <Field Name="DistanceUnit">
                    <DataField>DistanceUnit</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
                <Field Name="Volume">
                    <DataField>Volume</DataField>
                    <rd:TypeName>System.Decimal</rd:TypeName>
                </Field>
                <Field Name="VolumeUnit">
                    <DataField>VolumeUnit</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
                <Field Name="Cost">
                    <DataField>Cost</DataField>
                    <rd:TypeName>System.Decimal</rd:TypeName>
                </Field>
                <Field Name="Currency">
                    <DataField>Currency</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
                <Field Name="Price">
                    <DataField>Price</DataField>
                    <rd:TypeName>System.Decimal</rd:TypeName>
                </Field>
                <Field Name="Consumption">
                    <DataField>Consumption</DataField>
                    <rd:TypeName>System.Decimal</rd:TypeName>
                </Field>
                <Field Name="Station">
                    <DataField>Station</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
                <Field Name="Full">
                    <DataField>Full</DataField>
                    <rd:TypeName>System.String</rd:TypeName>
                </Field>
            </Fields>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="Vehicle">
            <DataType>String</DataType>
            <Nullable>true</Nullable>
            <AllowBlank>true</AllowBlank>
            <DefaultValue>
                <Values>
                    <Value>Golf</Value>
                </Values>
            </DefaultValue>
            <Prompt>Vehicle</Prompt>
            <Hidden>true</Hidden>
        </ReportParameter>
    </ReportParameters>
